MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
APP_API_KEY=
RATE_LIMIT_PER_MINUTE=20
MAX_MESSAGE_LENGTH=4000

# Optional: without these, memory falls back to a local SQLite file
# (backend/data/memory.db) that does NOT survive a Render redeploy/restart.
# Create a free database at https://turso.tech to persist conversations.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
