MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
APP_API_KEY=
RATE_LIMIT_PER_MINUTE=20
MAX_MESSAGE_LENGTH=4000

# Optional: without these, memory falls back to a local SQLite file
# (backend/data/memory.db) that does NOT survive a Render redeploy/restart.
# Create a free database at https://turso.tech to persist conversations.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: without this, NEXUS's search_web tool is simply never offered
# to it -- no error, no degraded behavior, just no live web search.
# Create a free key at https://tavily.com.
TAVILY_API_KEY=

# Optional: without GITHUB_PAT, NEXUS's read_github_file tool is simply never
# offered -- no error, no degraded behavior, just no GitHub access. Read-only
# and repo-scoped by design:
#   1. Create a fine-grained personal access token at
#      https://github.com/settings/personal-access-tokens/new
#   2. Under "Repository access", select only the specific repositories you
#      want readable -- never "All repositories".
#   3. Under "Permissions", grant only "Contents: Read-only" (plus the
#      mandatory "Metadata: Read-only"). Grant nothing else -- there is no
#      write path in this app to use a broader token for anyway.
# GITHUB_ALLOWED_REPOS is enforced again on the server as defense in depth,
# in case the token itself is ever more broadly scoped than intended --
# comma-separated "owner/repo" (e.g. "leerobber/AILicious,leerobber/other-repo").
GITHUB_PAT=
GITHUB_ALLOWED_REPOS=
